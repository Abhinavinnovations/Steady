{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.steady_7ogf.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://steady-7wy0t47-preview-4200.runable.site/",
      "applicationId": "steady-7wy0t47",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.steady_7ogf.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0A0F"
    },
    "name": "Steady",
    "slug": "steady",
    "version": "1.0.0",
    "scheme": "runable-steady-7wy0t47",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-audio"
    ]
  }
}
