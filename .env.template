# Single root environment file. Never commit real credentials.
NODE_ENV=development
# Actual web/API origin, matching this project's assigned managed port/domain.
WEBSITE_URL=
APPLICATION_ID=
VITE_RUNABLE_AUTH_ISSUER=
# Mobile fallback only: expo.extra.apiUrl takes precedence. No secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=

# Better Auth - Configuration
BETTER_AUTH_SECRET=
# Optional privileged SQL console. Blank means console access is refused.
ADMIN_KEY=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Server-only transactional email. Choose gmail for a small free trial, resend for a verified domain.
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Enable only after verified additive invitation + recipient-consent migrations.
INVITATION_DELIVERY_ENABLED=false
RECIPIENT_FLOW_ENABLED=false
# Public HTTPS web/API origin with exact /invitation path (not mobile /profile).
INVITATION_APP_URL=
# Future-only, explicitly consented Challenge alerts. No scheduled delivery guarantee.
MISS_ALERTS_ENABLED=false
MISS_ALERTS_START_DATE=
